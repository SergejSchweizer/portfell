# Portfell final local runtime.
#
# Passwords stay in absolute host files outside this repository. The market DSN carries no
# password; the password is supplied through the separate secret file boundary.

PORTFELL_PORT=8080
PORTFELL_POSTGRES_PASSWORD_FILE=/run/host-secrets/portfell/postgres-password.txt
PORTFELL_MARKET_DATABASE_URL=postgresql://portfell@10.10.1.3:54321/xetra_loader
PORTFELL_MARKET_POSTGRES_PASSWORD_FILE=/run/host-secrets/portfell/market-postgres-password.txt
