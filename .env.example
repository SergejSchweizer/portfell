# Portfell hosted development runtime.
#
# Secret path values must be absolute host paths outside this repository.
# Create these files locally and never commit them.

PORTFELL_API_PORT=8000
PORTFELL_WEB_PORT=3000
PORTFELL_SHARED_DATA_DIR=/var/lib/portfell/shared-data
PORTFELL_LAKE_GROUP_ID=10
PORTFELL_POSTGRES_PASSWORD_FILE=/run/host-secrets/portfell/postgres-password.txt
PORTFELL_EODHD_KEK_FILE=/run/host-secrets/portfell/eodhd-kek.txt
