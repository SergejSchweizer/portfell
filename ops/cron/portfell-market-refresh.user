# Publish all active listings and market quotes from the external PostgreSQL source.
# User crontab: every Sunday at 12:00 local server time.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Vienna

0 12 * * 0 PORTFELL_MARKET_DATABASE_URL=postgresql://portfell@10.10.1.3:54321/xetra_loader PORTFELL_MARKET_DATABASE_PASSWORD_FILE=/home/dev_portfell/secrets/portfell/market_postgres_password PORTFELL_CONFIG_PATH=/home/dev_portfell/portfell/config.yaml PORTFELL_MARKET_DATA_ROOT=/home/dev_portfell/portfell/market-data /home/dev_portfell/portfell/.venv/bin/portfell-market-refresh >> /home/dev_portfell/portfell/logs/market-refresh.log 2>&1
